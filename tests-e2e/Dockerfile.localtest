FROM mcr.microsoft.com/playwright:v1.62.1-jammy

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json ./server/package.json

RUN CI=true pnpm install --frozen-lockfile --ignore-scripts

COPY generated/api ./generated/api
COPY generated/tests/index.gen.ts ./generated/tests/index.gen.ts
COPY tests-e2e ./tests-e2e

ENV PATH="/app/node_modules/.bin:${PATH}"

CMD ["playwright", "test", "--config", "tests-e2e/playwright.config.ts"]
