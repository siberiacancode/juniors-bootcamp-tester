  "info": {
    "title": "juniors bootcamp backend 🔥",
    "description": "Апи для выполнения индивидуальных заданий",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": ""
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "89990009999"
          }
        },
        "required": ["phone"]
      },
      "OtpResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Статус запроса"
          },
          "reason": {
            "type": "string",
            "description": "Причина ошибки"
          },
          "retryDelay": {
            "type": "number",
            "example": 120000,
            "description": "Время запроса повторного отп кода в мс"
          }
        },
        "required": ["success", "retryDelay"]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "89990009999",
            "description": "Номер телефона"
          },
          "code": {
            "type": "number",
            "example": 345231,
            "description": "Отп код"
          }
        },
        "required": ["phone", "code"]
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "ID пользователя"
          },
          "phone": {
            "type": "string",
            "example": "89990009999",
            "description": "Номер телефона"
          },
          "firstname": {
            "type": "string",
            "example": "firstname",
            "description": "Имя"
          },
          "middlename": {
            "type": "string",
            "example": "middlename",
            "description": "Отчество"
          },
          "lastname": {
            "type": "string",
            "example": "lastname",
            "description": "Фамилия"
          },
          "email": {
            "type": "string",
            "example": "email@gmail.com",
            "description": "Почта"
          },
          "city": {
            "type": "string",
            "example": "city",
            "description": "Город"
          }
        },
        "required": ["_id", "phone"]
      },
      "SignInResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Статус запроса"
          },
          "reason": {
            "type": "string",
            "description": "Причина ошибки"
          },
          "user": {
            "description": "Пользователь",
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ]
          },
          "token": {
            "type": "string",
            "description": "Пользовательский токен"
          }
        },
        "required": ["success", "user", "token"]
      },
      "UpdateProfileProfileDto": {
        "type": "object",
        "properties": {
          "firstname": {
            "type": "string",
            "example": "firstname",
            "description": "Имя"
          },
          "middlename": {
            "type": "string",
            "example": "middlename",
            "description": "Отчество"
          },
          "lastname": {
            "type": "string",
            "example": "lastname",
            "description": "Фамилия"
          },
          "email": {
            "type": "string",
            "example": "email@gmail.com",
            "description": "Почта"
          },
          "city": {
            "type": "string",
            "example": "city",
            "description": "Город"
          }
        }
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "profile": {
            "description": "Данные пользователя",
            "allOf": [
              {
                "$ref": "#/components/schemas/UpdateProfileProfileDto"
              }
            ]
          },
          "phone": {
            "type": "string",
            "example": "89990009999",
            "description": "Номер телефона"
          }
        },
        "required": ["profile", "phone"]
      },
      "UpdateProfileResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Статус запроса"
          },
          "reason": {
            "type": "string",
            "description": "Причина ошибки"
          },
          "user": {
            "description": "Пользователь",
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ]
          }
        },
        "required": ["success", "user"]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Статус запроса"
          },
          "reason": {
            "type": "string",
            "description": "Причина ошибки"
          },
          "user": {
            "description": "Пользователь",
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ]
          }
        },
        "required": ["success", "user"]
      },
      "GameFilter": {
        "type": "string",
        "enum": ["dlc", "discount"]
      },
      "GameView": {
        "type": "string",
        "enum": ["popular", "new"]
      },
      "GameGenre": {
        "type": "string",
        "enum": [
          "action",
          "adventure",
          "rpg",
          "strategy",
          "shooter",
          "simulation",
          "survival",
          "sports",
          "racing",
          "indie",
          "horror"
        ]
      },
      "GameType": {
        "type": "string",
        "enum": ["game", "dlc"],
        "description": "Тип"
      },
      "Region": {
        "type": "string",
        "enum": ["ru", "kz", "by", "ua", "pl", "tr", "all_world", "europe", "asia"],
        "description": "Регион"
      },
      "DeliveryType": {
        "type": "string",
        "enum": [
          "steam_key",
          "steam_gift",
          "epic_key",
          "nintendo_key",
          "xbox_key",
          "playstation_key"
        ],
        "description": "Способ получения"
      },
      "PriceVariant": {
        "type": "object",
        "properties": {
          "region": {
            "example": "europe",
            "description": "Регион",
            "allOf": [
              {
                "$ref": "#/components/schemas/Region"
              }
            ]
          },
          "price": {
            "type": "number",
            "example": 968,
            "description": "Текущая цена"
          },
          "oldPrice": {
            "type": "number",
            "example": 2688,
            "description": "Старая цена"
          },
          "deliveryType": {
            "example": "steam_key",
            "description": "Способ получения",
            "allOf": [
              {
                "$ref": "#/components/schemas/DeliveryType"
              }
            ]
          },
          "edition": {
            "type": "string",
            "example": "Deluxe",
            "description": "Издание"
          }
        },
        "required": ["region", "price", "deliveryType", "edition"]
      },
      "FilteredGame": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "battlefield-2042",
            "description": "Slug игры"
          },
          "name": {
            "type": "string",
            "example": "Battlefield 2042",
            "description": "Название игры"
          },
          "releaseDate": {
            "type": "number",
            "example": 1637280000,
            "description": "Дата релиза"
          },
          "type": {
            "example": "game",
            "description": "Тип",
            "allOf": [
              {
                "$ref": "#/components/schemas/GameType"
              }
            ]
          },
          "genres": {
            "type": "array",
            "example": ["action", "rpg"],
            "description": "Жанры игры",
            "items": {
              "$ref": "#/components/schemas/GameGenre"
            }
          },
          "image": {
            "type": "string",
            "example": "/static/images/games/cs2.webp",
            "description": "Изображение игры"
          },
          "priceVariant": {
            "description": "Наименьший вариант цены",
            "allOf": [
              {
                "$ref": "#/components/schemas/PriceVariant"
              }
            ]
          }
        },
        "required": ["slug", "name", "releaseDate", "type", "genres", "image", "priceVariant"]
      },
      "GamesPaginationMeta": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "example": 30,
            "description": "Общее количество элементов"
          },
          "page": {
            "type": "number",
            "example": 1,
            "description": "Текущая страница"
          },
          "limit": {
            "type": "number",
            "example": 10,
            "description": "Элементов на странице"
          },
          "totalPages": {
            "type": "number",
            "example": 3,
            "description": "Количество страниц"
          }
        },
        "required": ["total", "page", "limit", "totalPages"]
      },
      "GamesPaginatedResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Статус запроса"
          },
          "reason": {
            "type": "string",
            "description": "Причина ошибки"
          },
          "games": {
            "description": "Список игр",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilteredGame"
            }
          },
          "meta": {
            "description": "Пагинация",
            "allOf": [
              {
                "$ref": "#/components/schemas/GamesPaginationMeta"
              }
            ]
          }
        },
        "required": ["success", "games", "meta"]
      },
      "GameSearchResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Статус запроса"
          },
          "reason": {
            "type": "string",
            "description": "Причина ошибки"
          },
          "games": {
            "description": "Результаты поиска игр",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilteredGame"
            }
          }
        },
        "required": ["success", "games"]
      },
      "SystemRequirements": {
        "type": "object",
        "properties": {
          "oc": {
            "type": "string",
            "example": "Windows 10",
            "description": "Операционная система"
          },
          "processor": {
            "type": "string",
            "example": "Intel Core i5-9400F",
            "description": "Процессор"
          },
          "memory": {
            "type": "string",
            "example": "16 GB",
            "description": "Оперативная память"
          },
          "graphics": {
            "type": "string",
            "example": "NVIDIA GeForce GTX 1660",
            "description": "Видеокарта"
          },
          "storage": {
            "type": "string",
            "example": "500 GB",
            "description": "Место на диске"
          }
        }
      },
      "DetailedGame": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "battlefield-2042",
            "description": "Slug игры"
          },
          "name": {
            "type": "string",
            "example": "Battlefield 2042",
            "description": "Название игры"
          },
          "releaseDate": {
            "type": "number",
            "example": 1637280000,
            "description": "Дата релиза"
          },
          "type": {
            "example": "game",
            "description": "Тип",
            "allOf": [
              {
                "$ref": "#/components/schemas/GameType"
              }
            ]
          },
          "genres": {
            "type": "array",
            "example": ["action", "rpg"],
            "description": "Жанры игры",
            "items": {
              "$ref": "#/components/schemas/GameGenre"
            }
          },
          "image": {
            "type": "string",
            "example": "/static/images/games/cs2.webp",
            "description": "Изображение игры"
          },
          "deliveryTypes": {
            "type": "array",
            "example": ["steam_key", "xbox_key", "steam_gift"],
            "description": "Способ получения",
            "items": {
