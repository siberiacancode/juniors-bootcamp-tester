    "/api/games/info": {
      "get": {
        "operationId": "GamesController_getGames",
        "parameters": [
          {
            "name": "filter",
            "required": false,
            "in": "query",
            "description": "Дополнительные фильтры",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/GameFilter"
              }
            }
          },
          {
            "name": "view",
            "required": false,
            "in": "query",
            "description": "Предустановленный вид выборки",
            "schema": {
              "$ref": "#/components/schemas/GameView"
            }
          },
          {
            "name": "genre",
            "required": false,
            "in": "query",
            "description": "Жанр",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/GameGenre"
              }
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Страница",
            "schema": {
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Лимит",
            "schema": {
              "example": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GamesPaginatedResponse"
                }
              }
            }
          }
        },
        "summary": "Получить игры",
        "tags": ["🎮 games"]
      }
    },
