{
  "name": "juniors-bootcamp-tester",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev-mock": "pnpm mock & vite --mode mock",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "types": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint-inspector": "npx @eslint/config-inspector@latest",
    "format": "prettier --write .",
    "pretty": "pnpm types && pnpm lint && pnpm format",
    "unit-test": "vitest",
    "unit-mutation": "stryker run",
    "integration-test": "pnpm pw tests/playwright-browser.config.ts tests/playwright-component.config.ts --env-file .env.mock --image jb-tester-tests-image --container jb-tester-tests-container --dockerfile tests/Dockerfile.localtest --mount mock:/app/mock --mount src:/app/src --mount static:/app/static:ro --mount generated:/app/generated --mount tests:/app/tests --mount package.json:/app/package.json:ro --mount pnpm-lock.yaml:/app/pnpm-lock.yaml:ro --mount pnpm-workspace.yaml:/app/pnpm-workspace.yaml:ro --mount vite.config.ts:/app/vite.config.ts:ro --mount .env.mock:/app/.env.mock:ro --no-local",
    "generate-api": "pnpm apicraft",
    "mock": "mcs --config ./mock/mock-server.config.ts --watch",
    "prepare": "lefthook install || true & pnpm playwright install"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@siberiacancode/fetches": "^1.14.3",
    "@siberiacancode/reactuse": "^1.0.15",
    "@siberiacancode/uikit": "^1.1.3",
    "@tanstack/react-query": "^5.102.0",
    "@tanstack/react-router": "^1.170.32",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-intl": "^10.1.23",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@siberiacancode/apicraft": "^1.12.1",
    "@siberiacancode/eslint": "2.18.1",
    "@siberiacancode/lefthook": "1.0.2",
    "@siberiacancode/playwright": "1.0.0",
    "@siberiacancode/prettier": "^1.9.0",
    "@siberiacancode/testids": "1.0.0",
    "@siberiacancode/vitest": "2.5.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.34",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "4.1.10",
    "mock-config-server": "5.0.0-beta.4",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.2.1"
  }
}
